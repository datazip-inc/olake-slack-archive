  {
    "client_msg_id": "6bba2508-cfa4-4d30-a7f1-17d7b493358f",
    "type": "message",
    "user": "U0A9LUUNP43",
    "text": "\u003c@U0A5EGHRLQY\u003e We currently don't support Fusion with S3 as the `logFileStorageMode`. Our internal team is working on adding this capability, and we expect to release it soon.\nSince you're using Fusion, Helm is throwing the following error because Fusion is currently incompatible with S3 log storage:\n`Fusion is not supported when global.logFileStorageMode is s3; set fusion.enabled to false or use nfs`\nAs a result, the Helm upgrade is blocked.\nCC: \u003c@U08RZQ547LJ\u003e",
    "ts": "1791579918.771759",
    "thread_ts": "1791568537.516499",
    "parent_user_id": "U0A5EGHRLQY",
    "team": "T0820LGJGRF",
