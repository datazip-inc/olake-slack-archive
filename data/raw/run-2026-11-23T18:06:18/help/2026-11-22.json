  {
    "client_msg_id": "2a0cdf4d-2cf0-4ff1-bd2b-a13b6715f83a",
    "type": "message",
    "user": "U08S0TP9R3P",
    "text": "\u0026gt;  Does some settings needs to be changed for this?\n\u003c@U0BTUQGHDDF\u003e from the logs, reading the oplog was much slower than usual for this run, likely due to higher activity on the database, so each collection took longer to catch up.\n\nWith max_threads at 2, only 2 of the 7 collections ran at a time, and the rest waited with a growing backlog. Please increase max_threads to 7 so all collections run in parallel.",
    "ts": "1795411043.055749",
    "thread_ts": "1795405793.471969",
    "parent_user_id": "U0BTUQGHDDF",
    "team": "T0820LGJGRF",
    "replace_original": false,
    "delete_original": false,
    "metadata": {
      "event_type": "",
      "event_payload": null
    },
    "blocks": [
      {
        "type": "rich_text",
        "block_id": "D8NJr",
        "elements": [
          {
            "type": "rich_text_quote",
            "elements": [
              {
                "type": "text",
                "text": " Does some settings needs to be changed for this?"
              }
            ]
          },
          {
            "type": "rich_text_section",
            "elements": [
              {
                "type": "text",
                "text": "\n"
              },
              {
                "type": "user",
                "user_id": "U0BTUQGHDDF"
              },
              {
                "type": "text",
                "text": " from the logs, reading the oplog was much slower than usual for this run, likely due to higher activity on the database, so each collection took longer to catch up.\n\nWith max_threads at 2, only 2 of the 7 collections ran at a time, and the rest waited with a growing backlog. Please increase max_threads to 7 so all collections run in parallel."
              }
            ]
          }
        ]
      }
    ],
