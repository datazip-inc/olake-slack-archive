                "elements": [
                  {
                    "type": "text",
                    "text": "The info box says if catalog name left empty, it will default to olake_iceberg, but the box is a required field"
                  }
                ]
              }
            ],
            "style": "bullet",
            "indent": 0,
            "border": 1,
            "offset": 0
          },
          {
            "type": "rich_text_section",
            "elements": [
              {
                "type": "text",
                "text": "\nHey "
              },
              {
                "type": "user",
                "user_id": "U0ACFDEBBQB"
              },
              {
                "type": "text",
                "text": ", both of these issues have been fixed in our new release, "
              },
              {
                "type": "text",
                "text": "OLake-UI v0.4.9",
                "style": {
                  "bold": true
                }
              },
              {
                "type": "text",
                "text": ".\n\nIf you're using Helm, please redeploy your Helm release to pick up the latest changes.\n\nEDIT: If you're using the "
