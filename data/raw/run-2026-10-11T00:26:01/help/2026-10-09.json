            "elements": [
              {
                "type": "user",
                "user_id": "U0A5EGHRLQY"
              },
              {
                "type": "text",
                "text": " We currently don't support Fusion with S3 as the "
              },
              {
                "type": "text",
                "text": "logFileStorageMode",
                "style": {
                  "code": true
                }
              },
              {
                "type": "text",
                "text": ". Our internal team is working on adding this capability, and we expect to release it soon.\nSince you're using Fusion, Helm is throwing the following error because Fusion is currently incompatible with S3 log storage:\n"
              },
              {
                "type": "text",
                "text": "Fusion is not supported when global.logFileStorageMode is s3; set fusion.enabled to false or use nfs",
                "style": {
                  "code": true
                }
              },
              {
                "type": "text",
                "text": "\nAs a result, the Helm upgrade is blocked.\nCC: "
              },
              {
                "type": "user",
