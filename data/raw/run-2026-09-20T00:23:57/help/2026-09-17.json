  {
    "client_msg_id": "627f74c9-f8ee-4e12-b4c3-358704df7528",
    "type": "message",
    "user": "U08S0TP9R3P",
    "text": "\u003c@U09KQFGF7J4\u003e You can use this query to check the current mode:\n```SELECT\n    c.relname AS table_name,\n    CASE c.relreplident\n        WHEN 'd' THEN 'DEFAULT'\n        WHEN 'n' THEN 'NOTHING'\n        WHEN 'f' THEN 'FULL'\n        WHEN 'i' THEN 'INDEX'\n    END AS replica_identity\nFROM pg_class c\nWHERE c.relname = 'your_table';```\nTo set it to full, please use this query:\n```ALTER TABLE your_table REPLICA IDENTITY FULL;```",
    "ts": "1789642828.820609",
    "thread_ts": "1789640945.427669",
    "parent_user_id": "U09KQFGF7J4",
    "team": "T0820LGJGRF",
    "replace_original": false,
    "delete_original": false,
    "metadata": {
      "event_type": "",
      "event_payload": null
    },
    "blocks": [
      {
        "type": "rich_text",
        "block_id": "86zX5",
        "elements": [
          {
            "type": "rich_text_section",
            "elements": [
              {
                "type": "user",
                "user_id": "U09KQFGF7J4"
              },
              {
                "type": "text",
                "text": " You can use this query to check the current mode:\n"
              }
            ]
          },
          {
            "type": "rich_text_preformatted",
            "elements": [
              {
                "type": "text",
                "text": "SELECT\n    c.relname AS table_name,\n    CASE c.relreplident\n        WHEN 'd' THEN 'DEFAULT'\n        WHEN 'n' THEN 'NOTHING'\n        WHEN 'f' THEN 'FULL'\n        WHEN 'i' THEN 'INDEX'\n    END AS replica_identity\nFROM pg_class c\nWHERE c.relname = 'your_table';"
              }
            ],
            "border": 0
          },
          {
            "type": "rich_text_section",
            "elements": [
              {
                "type": "text",
                "text": "\nTo set it to full, please use this query:\n"
              }
            ]
          },
          {
            "type": "rich_text_preformatted",
            "elements": [
              {
                "type": "text",
                "text": "ALTER TABLE your_table REPLICA IDENTITY FULL;"
              }
            ],
            "border": 0
          }
        ]
      }
    ],
    "user_team": "T0820LGJGRF",
