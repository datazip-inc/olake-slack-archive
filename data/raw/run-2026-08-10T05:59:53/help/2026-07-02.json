    "type": "message",
    "user": "U08CR7HUWDC",
    "text": "\u003c@U0AGV5S9UR2\u003e\nIn *upsert* mode, writing equality delete files cannot be avoided, whereas in *append* mode, no equality delete files are written. If you wants to reclaim disk space after compaction and remove orphan files, you'll need to configure your compaction job accordingly.",
    "ts": "1782986775.270799",
    "thread_ts": "1782902467.145229",
    "parent_user_id": "U0AGV5S9UR2",
    "team": "T0820LGJGRF",
    "replace_original": false,
    "delete_original": false,
    "metadata": {
      "event_type": "",
      "event_payload": null
    },
    "blocks": [
      {
        "type": "rich_text",
        "block_id": "6DdbG",
        "elements": [
          {
            "type": "rich_text_section",
            "elements": [
              {
                "type": "user",
                "user_id": "U0AGV5S9UR2"
              },
              {
                "type": "text",
                "text": "\nIn "
              },
              {
                "type": "text",
                "text": "upsert",
                "style": {
                  "bold": true
                }
              },
              {
                "type": "text",
                "text": " mode, writing equality delete files cannot be avoided, whereas in "
              },
              {
                "type": "text",
                "text": "append",
                "style": {
                  "bold": true
                }
              },
              {
                "type": "text",
                "text": " mode, no equality delete files are written. If you wants to reclaim disk space after compaction and remove orphan files, you'll need to configure your compaction job accordingly."
              }
            ]
          }
        ]
      }
    ],
