                "text": "const start = Math.floor(Date.now() / 1000) - 3600, began = Date.now();\nlet events = 0, pos = start;\ndb.getMongo().setReadConcern(\"majority\");\nconst cs = db.getSiblingDB(\"juno_v2_prod_money\").generic_gv.watch(\n  [{ $match: { operationType: { $in: [\"insert\", \"update\", \"replace\", \"delete\"] } } }],\n  { startAtOperationTime: Timestamp({ t: start, i: 0 }), fullDocument: \"updateLookup\", fullDocumentBeforeChange: \"whenAvailable\", maxAwaitTimeMS: 2000 }\n);\nwhile (Date.now() - began \u003c 300000) {\n  const doc = cs.tryNext();\n  if (doc) { events++; pos = doc.clusterTime.getHighBits(); }\n  else { const tok = cs.getResumeToken(); if (tok \u0026\u0026 tok._data) pos = parseInt(tok._data.substr(2, 8), 16); }\n}\ncs.close();\nconst wall = (Date.now() - began) / 1000;\nprint(`olake: oplog_covered=${pos - start}s speed=${((pos - start) / wall).toFixed(2)}x events=${events} events_per_sec=${(events / wall).toFixed(1)}`);"
