  {
    "client_msg_id": "7edc4ce5-b4ae-488e-95fd-dc3fa809f6a3",
    "type": "message",
    "user": "U08S0TP9R3P",
    "text": "Hey \u003c@U09KQFGF7J4\u003e, This is due to TOAST value in your table, during CDC syncs if your replication mode is set to `default` the toast values are not included hence olake currently adds this place holder text there. You can either set the replication mode to `FULL` if possible and it should work fine.\n\nHowever, we are working on a feature which will handle updates on toast containing rows even on `default` mode. You can follow this \u003chttps://github.com/datazip-inc/olake/issues/1176|issue\u003e for updates. Thanks",
    "ts": "1789642498.396309",
    "thread_ts": "1789640945.427669",
    "parent_user_id": "U09KQFGF7J4",
    "team": "T0820LGJGRF",
    "replace_original": false,
    "delete_original": false,
    "metadata": {
