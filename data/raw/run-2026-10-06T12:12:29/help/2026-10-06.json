            "type": "rich_text_section",
            "elements": [
              {
                "type": "text",
                "text": "Hey "
              },
              {
                "type": "user",
                "user_id": "U0BTUQGHDDF"
              },
              {
                "type": "text",
                "text": ", this error comes from a BigLake limit: an Iceberg table's "
              },
              {
                "type": "text",
                "text": "metadata.json",
                "style": {
                  "code": true
                }
              },
              {
                "type": "text",
                "text": " can't be larger than "
              },
              {
                "type": "text",
                "text": "1 MB. ",
                "style": {
                  "bold": true
                }
              },
              {
                "type": "text",
                "text": "You can check this "
              },
              {
                "type": "link",
                "url": "https://docs.cloud.google.com/lakehouse/docs/set-up-lakehouse-iceberg-rest-catalog",
                "text": "doc"
              },
              {
                "type": "text",
                "text": ", under Data limitations.\n\nYour data is safe. The sync state didn't move forward, so the next successful run will pick up from where it stopped. It would be great if you could DM me your latest "
              },
              {
                "type": "text",
                "text": "metadata.json",
                "style": {
                  "code": true
                }
              },
              {
                "type": "text",
                "text": " for this iceberg table. This will show us exactly what's taking up the space.\n\nTo find "
              },
              {
                "type": "text",
                "text": "metadata.json",
                "style": {
                  "code": true
                }
              },
              {
                "type": "text",
                "text": ":\n"
              }
            ]
          },
          {
            "type": "rich_text_list",
            "elements": [
              {
                "type": "rich_text_section",
                "elements": [
                  {
                    "type": "text",
                    "text": "Open the GCS bucket you set as the BigLake Catalog Path in your OLake destination."
                  }
                ]
              },
              {
                "type": "rich_text_section",
                "elements": [
                  {
                    "type": "text",
                    "text": "Open the namespace folder "
                  },
                  {
                    "type": "text",
                    "text": "juno_v2_prod_order_juno_v2_prod_order",
                    "style": {
                      "code": true
                    }
                  },
                  {
                    "type": "text",
                    "text": ", then the table folder "
                  },
                  {
                    "type": "text",
                    "text": "order_v2",
                    "style": {
                      "code": true
                    }
                  },
                  {
                    "type": "text",
                    "text": ", then "
                  },
                  {
                    "type": "text",
                    "text": "metadata/",
                    "style": {
                      "code": true
                    }
                  },
                  {
                    "type": "text",
                    "text": ". If the folders aren't laid out like that, search the bucket for "
                  },
                  {
                    "type": "text",
                    "text": "order_v2",
                    "style": {
                      "code": true
                    }
                  },
                  {
                    "type": "text",
                    "text": ". "
                  }
                ]
              },
              {
                "type": "rich_text_section",
                "elements": [
                  {
                    "type": "text",
                    "text": "Pick the "
                  },
                  {
                    "type": "text",
                    "text": "*.metadata.json",
                    "style": {
                      "code": true
                    }
                  },
                  {
                    "type": "text",
                    "text": " file with the highest number at the start of its name (e.g. "
                  },
                  {
                    "type": "text",
                    "text": "01243-xxxx.metadata.json",
                    "style": {
                      "code": true
                    }
                  },
                  {
                    "type": "text",
                    "text": "). That's the latest version. You can sort the files based on date created / added, and share the latest one."
                  }
                ]
              }
            ],
