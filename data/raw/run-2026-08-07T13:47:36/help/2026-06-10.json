  {
    "client_msg_id": "37b399b0-f6eb-4b58-b4dc-28773fce355e",
    "type": "message",
    "user": "U0AQHEXPAUQ",
    "text": "```SELECT\n    COUNT(*) AS total_rows,\n    COUNT(*) FILTER (WHERE pg_column_size(invoice_details) \u0026gt; 2048) AS rows_over_2kb,\n    MAX(pg_column_size(invoice_details)) AS max_size_bytes,\n    ROUND(MAX(pg_column_size(invoice_details)) / 1024.0, 2) AS max_size_kb,\n    ROUND(AVG(pg_column_size(invoice_details)), 2) AS avg_size_bytes\nFROM invoices;```",
    "ts": "1781108891.578909",
    "thread_ts": "1781081500.170139",
    "parent_user_id": "U0AQHEXPAUQ",
    "team": "T0820LGJGRF",
    "replace_original": false,
    "delete_original": false,
    "metadata": {
      "event_type": "",
      "event_payload": null
    },
    "blocks": [
      {
        "type": "rich_text",
        "block_id": "vizF3",
        "elements": [
          {
            "type": "rich_text_preformatted",
            "elements": [
              {
                "type": "text",
                "text": "SELECT\n    COUNT(*) AS total_rows,\n    COUNT(*) FILTER (WHERE pg_column_size(invoice_details) \u003e 2048) AS rows_over_2kb,\n    MAX(pg_column_size(invoice_details)) AS max_size_bytes,\n    ROUND(MAX(pg_column_size(invoice_details)) / 1024.0, 2) AS max_size_kb,\n    ROUND(AVG(pg_column_size(invoice_details)), 2) AS avg_size_bytes\nFROM invoices;"
              }
            ],
            "border": 0
          }
        ]
      }
    ],
